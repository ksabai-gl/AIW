# Must match the port printed by the server: [cursor-agent-bridge] http://127.0.0.1:PORT
# Copy to `.env` in this folder so both `node server/index.mjs` and Vite use the same port.
AGENT_BRIDGE_PORT=3847

# Optional: lower this (default 2500) to force prompt-via-temp-file earlier on Windows (avoids "command line is too long").
# BRIDGE_PROMPT_FILE_MIN_LEN=1500

# Optional: absolute path to `kiro` if not on PATH (same role as CURSOR_AGENT_BIN for `agent`).
# KIRO_AGENT_BIN=C:\\path\\to\\kiro.exe

